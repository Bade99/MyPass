root = true

[*.h]
charset = utf-8
end_of_line = lf
indent_style = tab
tab_width = 4

[*.cpp]
charset = utf-8
end_of_line = lf
indent_style = tab
tab_width = 4

[src/protect.rc]
charset = utf-16le
end_of_line = crlf
indent_style = space

[src/versioninfo.rc2]
charset = utf-8
end_of_line = crlf
indent_style = space

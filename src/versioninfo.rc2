/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SOLUTION_FILEVERSION_NUMBER
 PRODUCTVERSION SOLUTION_PRODUCTVERSION_NUMBER
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000904b0"
        BEGIN
            VALUE "CompanyName", SOLUTION_COMPANYNAME
            VALUE "FileDescription", SOLUTION_FILEDESCRIPTION
            VALUE "FileVersion", SOLUTION_FILEVERSION_STRING
            VALUE "InternalName", SOLUTION_INTERNALNAME
            VALUE "LegalCopyright", SOLUTION_LEGALCOPYRIGHT
            VALUE "OriginalFilename", SOLUTION_ORIGINALFILENAME
            VALUE "ProductName", SOLUTION_PRODUCTNAME
            VALUE "ProductVersion", SOLUTION_PRODUCTVERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x9, 1200
    END
END
